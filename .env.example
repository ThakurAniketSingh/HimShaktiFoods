# Copy this file to .env and fill in real values before running the
# project locally (`cp .env.example .env`).
#
# Never commit the real .env file — it's already listed in .gitignore.
# When deploying, set these same variables in your Vercel project under
# Settings → Environment Variables instead of relying on this file.

# ── Required ──────────────────────────────────────────────────────
# Your MongoDB Atlas connection string. Get one free at
# https://www.mongodb.com/cloud/atlas — create a cluster, add a database
# user, and copy the "mongodb+srv://..." connection string it gives you.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>

# The password used to log into /admin/login. Pick something only you
# know — this also doubles as the signing secret for admin session
# tokens (see lib/session.js), so keep it private and reasonably long.
ADMIN_PASSWORD=choose-a-strong-password-here

# ── Optional ──────────────────────────────────────────────────────
# Powers the AI chat assistant (api/chat.js). Without this, the site
# still works fine — the chat button just shows a "not configured yet"
# message instead of talking to an AI. Get a free key at
# https://console.groq.com
GROQ_API_KEY=
